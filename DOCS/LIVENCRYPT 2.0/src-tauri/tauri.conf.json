{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Livencrypt 2.0",
  "version": "2.11.0",
  "identifier": "com.synergia.livencrypt",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Livencrypt 2.0",
        "fullscreen": false,
        "width": 1920,
        "height": 1080,
        "contentProtected": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libcap2-bin"
        ],
        "postInstallScript": "scripts/postinstall.sh",
        "postRemoveScript": "scripts/postremove.sh"
      }
    },
    "icon": [
      "icons/livencrypt2.0_logo.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
