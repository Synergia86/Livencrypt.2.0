{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and tool windows",
  "windows": ["main", "text-cipher", "file-cipher", "template-editor"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
