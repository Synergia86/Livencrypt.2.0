FROM rust:1-bookworm

WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
COPY packaging ./packaging

RUN cargo build --release --locked

ENV HOME=/home/livencrypt
ENV XDG_DATA_HOME=/home/livencrypt/.local/share
RUN useradd -m -u 1000 livencrypt
USER livencrypt

CMD ["./target/release/livencrypt-core", "--self-test-safe"]
